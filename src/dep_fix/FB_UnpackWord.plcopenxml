        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_UnpackWord
(* Разделение 16-разрядного слова на два байта.
	Вход:  W - слово
	Выходы: Lo - младший байт (W.0..W.7), Hi - старший (W.8..W.15)
	Нужен там, где 16-разрядный результат надо положить в память
	побайтно (PUSH/CALL/RST - адрес возврата, SHLD, DAD - пара HL).
	Способ выделения байтов: bits. *)
VAR_INPUT
	W : WORD; (* исходное слово *)
END_VAR
VAR_OUTPUT
	Lo : BYTE; (* младший байт *)
	Hi : BYTE; (* старший байт *)
END_VAR
VAR
	up_lo : FB_PackByte; (* упаковка битов W.0..W.7 в младший байт *)
	up_hi : FB_PackByte; (* упаковка битов W.8..W.15 в старший байт *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
