	SELx : BYTE; (* код 0..7 *)
	I0 : BYTE; (* вход 0 *)
	I1 : BYTE; (* вход 1 *)
	I2 : BYTE; (* вход 2 *)
	I3 : BYTE; (* вход 3 *)
	I4 : BYTE; (* вход 4 *)
	I5 : BYTE; (* вход 5 *)
	I6 : BYTE; (* вход 6 *)
	I7 : BYTE; (* вход 7 *)
END_VAR
VAR_OUTPUT
	Q : BYTE; (* выбранное значение *)
END_VAR
</xhtml>
