        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Memory64K
(* Доступ к общей памяти эмулятора (64 КБ) по 16-разрядному адресу.
	Память лежит в GVL_MEM.Memory : ARRAY[0..65535] OF BYTE.
	Входы:  Addr - адрес (шина адреса), Wr - разрешение записи,
	        DataIn - данные для записи (шина данных)
	Выход:  DataOut - прочитанный байт (шина данных)
	Порядок сетей важен: сначала ЧТЕНИЕ, потом ЗАПИСЬ.
	За скан читается старое значение, запись происходит после -
	именно это нужно такту процессора (сначала выбрать операнды,
	потом записать результат).
	Условная запись выполнена через SEL: при Wr=FALSE в память
	записывается её же текущее значение. *)
VAR_INPUT
	Addr : WORD; (* адрес ячейки (шина адреса) *)
	Wr : BOOL; (* 1 = записать DataIn *)
	DataIn : BYTE; (* данные для записи (шина данных) *)
END_VAR
VAR_OUTPUT
	DataOut : BYTE; (* прочитанные данные (шина данных) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
