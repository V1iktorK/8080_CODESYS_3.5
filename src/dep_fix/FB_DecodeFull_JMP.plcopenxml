        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecodeFull_JMP
(* Распознавание переходов, вызовов и возвратов (группа C0h).
	Кодировка: поле битов 5..3 задаёт код условия, поле битов 5..4
	(старшие два бита кода условия) выбирает пару Jcc/JMP и т.д.
	  (IR AND C7h)=C2h : Jcc  (C2h JNZ, CAh JZ, D2h JNC, DAh JC,
	                            E2h JPO, EAh JPE, F2h JP, FAh JM)
	  (IR AND C7h)=C4h : Ccc  (CALL по условию, 8 кодов)
	  (IR AND C7h)=C0h : Rcc  (RET по условию, 8 кодов)
	  C3h = JMP, CDh = CALL, C9h = RET (безусловные формы).
	Классы операции: 26=JMP, 27=CALL, 28=RET.
	Выход Uncond = 1 для безусловных форм C3h/CDh/C9h:
	условие проверять не нужно, переход выполняется всегда.
	Код условия (C_Cond) берётся декодером прямо из битов 5..3
	регистра команды: 0=NZ 1=Z 2=NC 3=C 4=PO 5=PE 6=P 7=M. *)
VAR_INPUT
	IR : BYTE; (* регистр команды *)
END_VAR
VAR_OUTPUT
	Hit : BOOL; (* это переход/вызов/возврат *)
	Cls : BYTE; (* 26=JMP 27=CALL 28=RET *)
	Uncond : BOOL; (* безусловная форма *)
END_VAR
VAR
	isj : BOOL; (* признак Jcc (C2h + условие) *)
	isc : BOOL; (* признак Ccc (C4h + условие) *)
	isr : BOOL; (* признак Rcc (C0h + условие) *)
	jmpu : BOOL; (* признак JMP (C3h) *)
	callu : BOOL; (* признак CALL (CDh) *)
	retu : BOOL; (* признак RET (C9h) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
