        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Reg8Q
(* 8-разрядный регистр с четырьмя портами загрузки.
	Q := CLR ? 0 : (LD1 ? D1 : (LD2 ? D2 : (LD3 ? D3 : (LD4 ? D4 : Q))))
	Приоритет: CLR &gt; LD1 &gt; LD2 &gt; LD3 &gt; LD4 &gt; хранение.
	Порты 3 и 4 нужны команде XCHG (обмен DE &lt;-&gt; HL пишет сразу
	четыре регистра), порты 1 и 2 - LHLD, POP, SHLD, INR/DCR.
	Регистры обновляются в конце вызова: чтение Q в том же скане
	даёт значение, записанное предыдущим сканом. *)
VAR_INPUT
	D1 : BYTE; (* данные порта 1 *)
	LD1 : BOOL; (* загрузка порта 1 *)
	D2 : BYTE; (* данные порта 2 *)
	LD2 : BOOL; (* загрузка порта 2 *)
	D3 : BYTE; (* данные порта 3 *)
	LD3 : BOOL; (* загрузка порта 3 *)
	D4 : BYTE; (* данные порта 4 *)
	LD4 : BOOL; (* загрузка порта 4 *)
	CLR : BOOL; (* сброс в ноль (приоритетнее загрузки) *)
END_VAR
VAR_OUTPUT
	Q : BYTE; (* текущее значение регистра *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
