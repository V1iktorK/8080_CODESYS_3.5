        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Rotate8
(* Сдвиги аккумулятора: RLC, RRC, RAL, RAR.
	Входы:  A - аккумулятор, CY_In - текущий перенос, Kind - вид:
	        0=RLC (влево, бит 7 -&gt; CY и в бит 0),
	        1=RRC (вправо, бит 0 -&gt; CY и в бит 7),
	        2=RAL (влево через перенос: CY -&gt; бит 0, бит 7 -&gt; CY),
	        3=RAR (вправо через перенос: CY -&gt; бит 7, бит 0 -&gt; CY).
	Выходы: R - результат, CY_Out - новый перенос.
	Флаги S, Z, AC, P этими командами НЕ меняются.
	Реализация - на разрядах, а не сдвигами: в FBD сдвиг BYTE
	работает в разрядности BYTE, и полагаться на вынос бита нельзя.
	Каждый выходной разряд выбирается из двух входных (сосед слева
	или справа), а крайние разряды берут бит переноса либо бит
	с противоположного конца - ровно так работает кольцо. *)
VAR_INPUT
	A : BYTE; (* аккумулятор *)
	CY_In : BOOL; (* текущий перенос *)
	Kind : BYTE; (* вид сдвига 0..3 *)
END_VAR
VAR_OUTPUT
	Rx : BYTE; (* результат *)
	CY_Out : BOOL; (* новый перенос *)
END_VAR
VAR
	ua : FB_UnpackByte; (* распаковка аккумулятора *)
	up : FB_PackByte; (* упаковка результата *)
	b0 : BOOL; (* разряд 0 аккумулятора *)
	b1 : BOOL; (* разряд 1 аккумулятора *)
	b2 : BOOL; (* разряд 2 аккумулятора *)
	b3 : BOOL; (* разряд 3 аккумулятора *)
	b4 : BOOL; (* разряд 4 аккумулятора *)
	b5 : BOOL; (* разряд 5 аккумулятора *)
	b6 : BOOL; (* разряд 6 аккумулятора *)
	b7 : BOOL; (* разряд 7 аккумулятора *)
	right : BOOL; (* сдвиг вправо (RRC или RAR) *)
	lin : BOOL; (* бит, входящий слева (RLC: b7, RAL: CY) *)
	rin : BOOL; (* бит, входящий справа (RRC: b0, RAR: CY) *)
	o0 : BOOL; (* разряд 0 результата *)
	o1 : BOOL; (* разряд 1 результата *)
	o2 : BOOL; (* разряд 2 результата *)
	o3 : BOOL; (* разряд 3 результата *)
	o4 : BOOL; (* разряд 4 результата *)
	o5 : BOOL; (* разряд 5 результата *)
	o6 : BOOL; (* разряд 6 результата *)
	o7 : BOOL; (* разряд 7 результата *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
