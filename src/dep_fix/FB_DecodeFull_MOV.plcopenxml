        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecodeFull_MOV
(* Распознавание MOV: группа 01xxxxxx, то есть (IR AND C0h) = 40h.
	Код 0111 0110 (76h) исключён - это HLT, а не MOV M,M.
	Класс операции: 1 = MOV.
	Приёмник берётся из поля DDD = (IR SHR 3) AND 7, источник -
	из поля SSS = IR AND 7 (код 6 = память по адресу HL).
	Длина команды 1 байт. *)
VAR_INPUT
	IR : BYTE; (* регистр команды *)
END_VAR
VAR_OUTPUT
	Hit : BOOL; (* это MOV *)
	Cls : BYTE; (* класс операции C_Class = 1 (MOV) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
