        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Interrupt
(* Приём запроса прерывания (вход INT процессора).
	Прерывание принимается, если: INT_Req = 1, IFF = 1 (прерывания
	разрешены командой EI и запрещены DI) и Busy = 0 (предыдущее
	прерывание уже отработано). Приоритет внутри такта абсолютный:
	выборка и выполнение очередной команды заменяются переходом
	на обработчик.
	При приёме: PC &lt;- INT_Vector * 8, SP &lt;- SP - 2 (в стек по SP-1 и
	SP-2 процессор кладёт текущий PC), IFF &lt;- 0, Busy &lt;- 1.
	Команда RET при Busy = 1 снимает Busy и снова ставит IFF = 1 -
	так же, как в реальном 8080 (RET восстанавливает разрешение).
	Выходы: Take - прерывание принято, PC_Vec - адрес обработчика,
	        SP_New - новый указатель стека, Push_Needed - надо
	        положить PC в стек (совпадает с Take, отдельным
	        выходом - чтобы схема читалась как микрооперации). *)
VAR_INPUT
	INT_Req : BOOL; (* запрос прерывания *)
	IFF : BOOL; (* разрешение прерываний (триггер IFF) *)
	Busy : BOOL; (* прерывание уже обслуживается *)
	INT_Vector : BYTE; (* номер вектора 0..7 *)
	PC : WORD; (* текущий счётчик команд (кладётся в стек) *)
	SP : WORD; (* текущий указатель стека *)
END_VAR
VAR_OUTPUT
	Take : BOOL; (* прерывание принято *)
	PC_Vec : WORD; (* адрес обработчика = вектор * 8 *)
	SP_New : WORD; (* указатель стека после сохранения PC *)
	Push_Needed : BOOL; (* нужно положить PC в стек *)
END_VAR
VAR
	vec_w : WORD; (* вектор, расширенный до слова (см. журнал 10.1) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
