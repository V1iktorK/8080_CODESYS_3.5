        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Decoder_Full
(* Сводный декодер 8080: регистр команды -&gt; управляющее слово GVL_CPU.
	Вход: IR - код команды.
	Выход: набор полей прямо в GVL_CPU (см. таблицу классов там же):
	  C_Class  - класс операции 0..35;
	  C_Dst1/C_Dst2 - коды регистров-приёмников (портов записи два,
	             потому что LHLD, POP и XCHG пишут несколько регистров);
	  C_Src    - код источника (6 = память по HL);
	  C_RP     - код пары (0=BC 1=DE 2=HL 3=SP, для PUSH/POP - PSW);
	  C_ALU_Op - операция АЛУ в кодировке FB_ALU8 (0=ADD 1=ADC 2=SUB
	             3=SBB 4=ANA 5=ORA 6=XRA); поле xxx кодировки 8080
	             перекодируется: 5(XRA)&lt;-&gt;6(ORA), 7(CMP)-&gt;2(SUB)+IsCmp;
	  C_Cond   - код условия 0=NZ..7=M (для Jcc/Ccc/Rcc);
	  C_Vec    - вектор RST 0..7 (адрес = вектор * 8);
	  C_Rot    - вид сдвига 0=RLC 1=RRC 2=RAL 3=RAR;
	  C_Flag   - 0=CMA 1=STC 2=CMC;
	  C_Len    - длина команды (1, 2 или 3 байта);
	  C_RdSel  - какой адрес читать из памяти: 0=не надо 1=a16 2=BC
	             3=DE 4=SP (по нему читаются LDA/LHLD/LDAX, POP/RET/XTHL);
	  C_Uncond, C_IsCmp, C_Halt, C_EI, C_DI, C_IsPSW - признаки команд;
	  C_WReg1..C_WReg4 - разрешения записи в регистры по портам;
	  C_SZP_En, C_AC_En, C_CY_En - какие флаги обновлять:
	             ALU/ALUI/DAA меняют все пять флагов, INR/DCR - все
	             кроме CY, DAD и сдвиги - только CY, CMA - ничего;
	  C_LdPSW  - POP PSW: загрузить флаги из байта по адресу SP.
	Выходы вызовов девяти распознавателей сразу защёлкиваются в
	локальные переменные: выход FB нельзя ни разветвлять, ни читать
	из другой сети (CODESYS молча выбрасывает такой POU / вешает импорт). *)
VAR_INPUT
	IR : BYTE; (* регистр команды *)
END_VAR
VAR
	h_mov : BOOL; (* признак MOV *)
	h_mvi : BOOL; (* признак MVI *)
	h_alu : BOOL; (* признак ALU *)
	h_alui : BOOL; (* признак ALUI *)
	h_data : BOOL; (* признак группы 00h *)
	h_jmp : BOOL; (* признак переходов *)
	h_stk : BOOL; (* признак PUSH/POP *)
	h_spec : BOOL; (* признак отдельных команд *)
	h_hlt : BOOL; (* признак HLT *)
	cls_data : BYTE; (* класс от декодера группы 00h *)
	rot_data : BYTE; (* вид сдвига *)
	flag_data : BYTE; (* операция над флагами *)
	cls_jmp : BYTE; (* класс от декодера переходов *)
	uncond_jmp : BOOL; (* безусловная форма перехода *)
	cls_stk : BYTE; (* класс от декодера стека *)
	cls_spec : BYTE; (* класс от декодера отдельных команд *)
	cls : BYTE; (* итоговый класс операции *)
	f3 : BYTE; (* поле битов 5..3 *)
	src : BYTE; (* поле битов 2..0 *)
	rp : BYTE; (* код пары (биты 5..4) *)
	lxi_reg : BOOL; (* LXI с записью пары (не SP) *)
	rp3 : BOOL; (* код пары = 3 (SP или PSW) *)
	rp2 : BYTE; (* код пары * 2 *)
	rp2p1 : BYTE; (* код пары * 2 + 1 *)
	mdst : BOOL; (* поле DDD = 6 (приёмник - память) *)
	aop : BYTE; (* перекодированная операция АЛУ *)
	a_mov : BOOL; (* класс MOV *)
	a_mvi : BOOL; (* класс MVI *)
	a_alu : BOOL; (* класс ALU *)
	a_alui : BOOL; (* класс ALUI *)
	a_inr : BOOL; (* класс INR *)
	a_dcr : BOOL; (* класс DCR *)
	a_ldax : BOOL; (* класс LDAX *)
	a_stax : BOOL; (* класс STAX *)
	a_lda : BOOL; (* класс LDA *)
	a_sta : BOOL; (* класс STA *)
	a_lhld : BOOL; (* класс LHLD *)
	a_shld : BOOL; (* класс SHLD *)
	a_lxi : BOOL; (* класс LXI *)
	a_xchg : BOOL; (* класс XCHG *)
	a_xthl : BOOL; (* класс XTHL *)
	a_rot : BOOL; (* класс ROT *)
	a_flag : BOOL; (* класс FLAG *)
	a_daa : BOOL; (* класс DAA *)
	a_inx : BOOL; (* класс INX *)
	a_dcx : BOOL; (* класс DCX *)
	a_dad : BOOL; (* класс DAD *)
	a_ei : BOOL; (* класс EI *)
	a_di : BOOL; (* класс DI *)
	a_jmp : BOOL; (* класс JMP *)
	a_call : BOOL; (* класс CALL *)
	a_ret : BOOL; (* класс RET *)
	a_push : BOOL; (* класс PUSH *)
	a_pop : BOOL; (* класс POP *)
	a_in : BOOL; (* класс IN *)
	a_out : BOOL; (* класс OUT *)
	grp_mm : BOOL; (* приёмник - регистр (MOV/MVI/INR/DCR с DDD&lt;&gt;6) *)
	grp_am : BOOL; (* ALU с источником в памяти (SSS=6) *)
	grp_psw : BOOL; (* PUSH/POP PSW *)
	grp_lh : BOOL; (* приёмник - пара H/L (LHLD/SHLD/XTHL) *)
	grp_a : BOOL; (* приёмник - аккумулятор A *)
	grp_incdec : BOOL; (* INR или DCR *)
	grp_step_reg : BOOL; (* INX/DCX над парой (не SP): пишутся два регистра *)
	grp_szp : BOOL; (* S, Z, P обновляются *)
	grp_cy : BOOL; (* CY обновляется *)
	dst1 : BYTE; (* код приёмника порта 1 *)
	dst2 : BYTE; (* код приёмника порта 2 *)
	wr1a : BOOL; (* запись регистра портом 1 (по классу) *)
	flagcy : BOOL; (* FLAG со сменой CY (STC/CMC) *)
	d_mov : FB_DecodeFull_MOV; (* декодер MOV *)
	d_mvi : FB_DecodeFull_MVI; (* декодер MVI *)
	d_alu : FB_DecodeFull_ALU; (* декодер ALU *)
	d_alui : FB_DecodeFull_ALUI; (* декодер ALUI *)
	d_data : FB_DecodeFull_DATA; (* декодер группы 00h *)
	d_jmp : FB_DecodeFull_JMP; (* декодер переходов *)
	d_stk : FB_DecodeFull_STACK; (* декодер стека *)
	d_spec : FB_DecodeFull_SPEC; (* декодер отдельных команд *)
	d_hlt : FB_DecodeFull_HLT; (* декодер HLT *)
END_VAR
