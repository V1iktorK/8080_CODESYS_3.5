        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecodeFull_SPEC
(* Распознавание отдельных команд (это не группа, а список кодов):
	  EBh XCHG (17)  - обмен DE &lt;-&gt; HL
	  E3h XTHL (18)  - обмен HL с вершиной стека
	  F9h SPHL (19)  - SP := HL
	  E9h PCHL (20)  - PC := HL
	  FBh EI   (24)  - разрешить прерывания
	  F3h DI   (25)  - запретить прерывания
	  (IR AND C7h)=C7h - RST 0..7 (класс 31), вектор = биты 5..3:
	      C7h RST0, CFh RST1, D7h RST2, DFh RST3,
	      E7h RST4, EFh RST5, F7h RST6, FFh RST7. Адрес = вектор * 8.
	  DBh IN  d8 (33) - ЗАРЕЗЕРВИРОВАНО: аппаратный ввод, этап 3.6;
	  D3h OUT d8 (34) - ЗАРЕЗЕРВИРОВАНО: аппаратный вывод, этап 3.6.
	    (для IN/OUT длина команды 2 байта, сам обмен с портом ядро
	     пока не выполняет - PC просто проходит дальше) *)
VAR_INPUT
	IR : BYTE; (* регистр команды *)
END_VAR
VAR_OUTPUT
	Hit : BOOL; (* код из списка *)
	Cls : BYTE; (* класс операции *)
END_VAR
VAR
	isrst : BOOL; (* признак RST *)
	xchg : BOOL; (* признак XCHG *)
	xthl : BOOL; (* признак XTHL *)
	sphl : BOOL; (* признак SPHL *)
	pchl : BOOL; (* признак PCHL *)
	ei : BOOL; (* признак EI *)
	di : BOOL; (* признак DI *)
	inp : BOOL; (* признак IN (зарезервировано) *)
	outp : BOOL; (* признак OUT (зарезервировано) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
</project>
