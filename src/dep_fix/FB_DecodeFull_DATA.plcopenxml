        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecodeFull_DATA
(* Распознавание команд группы 00h (старшие два бита равны 00).
	Здесь собраны все команды с младшей тетрадой lo = IR AND 0Fh;
	старшая половина байта hi2 = (IR SHR 4) AND 3 выбирает пару
	регистров и исключения. Таблица (lo -&gt; класс операции):
	  lo=0,8 : NOP (коды 08h,10h,18h,20h,28h,30h,38h недокументированы)
	  lo=1   : LXI rp,d16            (класс 16)
	  lo=2   : STAX (hi2=0,1), SHLD (hi2=2), STA (hi2=3)  (11 / 15 / 13)
	  lo=3   : INX rp                (класс 7)
	  lo=4,C : INR r/M               (класс 5)
	  lo=5,D : DCR r/M               (класс 6)
	  lo=6,E : MVI r,d8              (класс 2)
	  lo=7   : RLC (hi2=0), RAL (hi2=1), DAA (hi2=2), STC (hi2=3) (21/21/23/22)
	  lo=9   : DAD rp                (класс 9)
	  lo=A   : LDAX (hi2=0,1), LHLD (hi2=2), LDA (hi2=3)  (10 / 14 / 12)
	  lo=B   : DCX rp                (класс 8)
	  lo=F   : RRC (hi2=0), RAR (hi2=1), CMA (hi2=2), CMC (hi2=3) (21/21/22/22)
	Дополнительно блок выдаёт:
	  Rot  - вид сдвига для FB_Rotate8: 0=RLC 1=RRC 2=RAL 3=RAR;
	  Flag - операция над флагами: 0=CMA 1=STC 2=CMC. *)
VAR_INPUT
	IR : BYTE; (* регистр команды *)
END_VAR
VAR_OUTPUT
	Hit : BOOL; (* команда группы 00h *)
	Cls : BYTE; (* класс операции (0..23) *)
	Rot : BYTE; (* вид сдвига 0..3 *)
	Flag : BYTE; (* 0=CMA 1=STC 2=CMC *)
END_VAR
VAR
	lo : BYTE; (* младшая тетрада IR *)
	hi2 : BYTE; (* биты 5..4: код пары или признак исключения *)
	c1 : BOOL; (* признак lo = 1 *)
	c2 : BOOL; (* признак lo = 2 *)
	c3 : BOOL; (* признак lo = 3 *)
	c4 : BOOL; (* признак lo = 4 *)
	c5 : BOOL; (* признак lo = 5 *)
	c6 : BOOL; (* признак lo = 6 *)
	c7 : BOOL; (* признак lo = 7 *)
	c9 : BOOL; (* признак lo = 9 *)
	cA : BOOL; (* признак lo = A *)
	cB : BOOL; (* признак lo = B *)
	cC : BOOL; (* признак lo = C *)
	cD : BOOL; (* признак lo = D *)
	cE : BOOL; (* признак lo = E *)
	cF : BOOL; (* признак lo = F *)
	h1 : BOOL; (* hi2 = 1 *)
	h2 : BOOL; (* hi2 = 2 *)
	h3 : BOOL; (* hi2 = 3 *)
	v_stax : BYTE; (* класс для lo=2: STAX / SHLD / STA *)
	v_rot : BYTE; (* класс для lo=7: ROT / DAA / FLAG *)
	v_ldax : BYTE; (* класс для lo=A: LDAX / LHLD / LDA *)
	v_cmc : BYTE; (* класс для lo=F: ROT / FLAG *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
