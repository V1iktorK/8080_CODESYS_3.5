        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DAA
(* Десятичная коррекция аккумулятора (DAA) для упакованного BCD.
	Правило 8080:
	  если (A AND 0Fh) &gt;= 0Ah или AC = 1, то A := A + 06h (старший
	     полубайт коррекции AC_Out := 1, иначе 0);
	  если A &gt;= 9Ah или CY = 1, то A := A + 60h, CY_Out := 1, иначе 0.
	Сложение идёт по модулю 256 (BYTE), как в реальном 8080.
	Входы:  A, AC_In, CY_In
	Выходы: R - результат, AC_Out, CY_Out - новые флаги AC и CY.
	Флаги S, Z, P считает вызывающая сторона (в ядре для этого
	используется свободный вызов FB_ALU8 с операцией ADD и B=0). *)
VAR_INPUT
	A : BYTE; (* аккумулятор *)
	AC_In : BOOL; (* флаг дополнительного переноса *)
	CY_In : BOOL; (* флаг переноса *)
END_VAR
VAR_OUTPUT
	Rx : BYTE; (* результат *)
	AC_Out : BOOL; (* новый AC (коррекция младшей тетрады) *)
	CY_Out : BOOL; (* новый CY (коррекция старшей тетрады) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
