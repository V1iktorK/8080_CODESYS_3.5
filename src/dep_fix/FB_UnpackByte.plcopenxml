        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_UnpackByte
(* Распаковка байта в 8 отдельных бит (BYTE -&gt; 8 x BOOL).
	Метод: маски и сдвиги. Для каждого разряда i:
	    Bi := (B AND mask_i) &lt;&gt; 0,   mask_i = 1,2,4,8,16,32,64,128
	Биты 0..7 - от младшего к старшему.
	Применяется для регистра флагов (PSW), кода операции и полей
	регистров в командах MOV/MVI. *)
VAR_INPUT
	B : BYTE; (* входной байт *)
END_VAR
VAR_OUTPUT
	B0 : BOOL; (* разряд 0 (вес 1) *)
	B1 : BOOL; (* разряд 1 (вес 2) *)
	B2 : BOOL; (* разряд 2 (вес 4) *)
	B3 : BOOL; (* разряд 3 (вес 8) *)
	B4 : BOOL; (* разряд 4 (вес 16) *)
	B5 : BOOL; (* разряд 5 (вес 32) *)
	B6 : BOOL; (* разряд 6 (вес 64) *)
	B7 : BOOL; (* разряд 7 (вес 128) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
</project>
