<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="" productName="CODESYS" productVersion="CODESYS V3.5 SP17 Patch 3" creationDateTime="2026-01-01T00:00:00" />
  <contentHeader name="FB_DecodeFull_ALU">
    <coordinateInfo>
      <fbd><scaling x="1" y="1" /></fbd>
      <ld><scaling x="1" y="1" /></ld>
      <sfc><scaling x="1" y="1" /></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes />
    <pous>
      <pou name="FB_DecodeFull_ALU" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="IR"><type><BYTE /></type></variable>
          </inputVars>
          <outputVars>
            <variable name="Hit"><type><BOOL /></type></variable>
            <variable name="Cls"><type><BYTE /></type></variable>
          </outputVars>
        </interface>
        <body>
          <FBD>
            <!-- СЕТЬ 1. Hit := (IR AND C0h) = 80h ; Cls := 3 -->
            <inVariable localId="1" height="10" width="38">
              <position x="40" y="40" />
              <connectionPointOut><relPosition x="38" y="5" /></connectionPointOut>
              <expression>IR</expression>
            </inVariable>
            <inVariable localId="2" height="10" width="110">
              <position x="40" y="70" />
              <connectionPointOut><relPosition x="110" y="5" /></connectionPointOut>
              <expression>BYTE#16#C0</expression>
            </inVariable>
            <block localId="3" typeName="AND" height="30" width="64">
              <position x="200" y="100" />
              <inputVariables>
                <variable formalParameter="IN1">
                  <connectionPointIn>
                    <relPosition x="0" y="5" />
                    <connection refLocalId="1" />
                  </connectionPointIn>
                </variable>
                <variable formalParameter="IN2">
                  <connectionPointIn>
                    <relPosition x="0" y="15" />
                    <connection refLocalId="2" />
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables />
              <outputVariables>
                <variable formalParameter="OUT">
                  <connectionPointOut>
                    <relPosition x="64" y="5" />
                  </connectionPointOut>
                </variable>
              </outputVariables>
            </block>
            <inVariable localId="4" height="10" width="110">
              <position x="40" y="130" />
              <connectionPointOut><relPosition x="110" y="5" /></connectionPointOut>
              <expression>BYTE#16#80</expression>
            </inVariable>
            <block localId="5" typeName="EQ" height="30" width="64">
              <position x="360" y="160" />
              <inputVariables>
                <variable formalParameter="IN1">
                  <connectionPointIn>
                    <relPosition x="0" y="5" />
                    <connection refLocalId="3" />
                  </connectionPointIn>
                </variable>
                <variable formalParameter="IN2">
                  <connectionPointIn>
                    <relPosition x="0" y="15" />
                    <connection refLocalId="4" />
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables />
              <outputVariables>
                <variable formalParameter="OUT">
                  <connectionPointOut>
                    <relPosition x="64" y="5" />
                  </connectionPointOut>
                </variable>
              </outputVariables>
            </block>
            <outVariable localId="6" height="10" width="47">
              <position x="520" y="190" />
              <connectionPointIn>
                <relPosition x="0" y="5" />
                <connection refLocalId="5" />
              </connectionPointIn>
              <expression>Hit</expression>
            </outVariable>
            <inVariable localId="7" height="10" width="74">
              <position x="40" y="220" />
              <connectionPointOut><relPosition x="74" y="5" /></connectionPointOut>
              <expression>BYTE#3</expression>
            </inVariable>
            <outVariable localId="8" height="10" width="47">
              <position x="520" y="250" />
              <connectionPointIn>
                <relPosition x="0" y="5" />
                <connection refLocalId="7" />
              </connectionPointIn>
              <expression>Cls</expression>
            </outVariable>
          </FBD>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecodeFull_ALU
(* Распознавание АЛУ-команд с регистром/памятью: группа 10xxxxxx,
	то есть (IR AND C0h) = 80h. Класс операции 3 = ALU.
	Поле xxx = биты 5..3 задаёт операцию в кодировке 8080:
	  0=ADD 1=ADC 2=SUB 3=SBB 4=ANA 5=XRA 6=ORA 7=CMP
	Коды АЛУ нашего FB_ALU8: 0=ADD 1=ADC 2=SUB 3=SBB 4=ANA 5=ORA 6=XRA,
	поэтому в FB_Decoder_Full 5 и 6 меняются местами, а 7 (CMP)
	превращается в 2 (SUB) с признаком C_IsCmp.
	Источник - поле SSS (6 = память по адресу HL). Длина 1 байт. *)
VAR_INPUT
	IR : BYTE; (* регистр команды *)
END_VAR
VAR_OUTPUT
	Hit : BOOL; (* это АЛУ-команда с регистром *)
	Cls : BYTE; (* класс операции C_Class = 3 (ALU) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
</project>
