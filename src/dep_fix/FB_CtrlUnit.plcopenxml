        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_CtrlUnit
(* Блок управления: проверка условия и расчёт адреса следующей команды.
	Входы:  Cond - код условия, S/Z/P/CY - флаги,
	        Uncond - переход безусловный, PC - текущий счётчик команд,
	        Target - адрес перехода (из двух байт команды), Len - длина
	Выходы: CondMet - условие выполнено,
	        Take - переход состоялся,
	        PC_Next - адрес следующей команды
	Коды условий: 0=NZ 1=Z 2=NC 3=C 4=PO 5=PE 6=P 7=M
	PC_Next := Take ? Target : PC + Len *)
VAR_INPUT
	Cond : BYTE; (* код условия 0..7 *)
	Sx : BOOL; (* флаг знака *)
	Z : BOOL; (* флаг нуля *)
	P : BOOL; (* флаг чётности *)
	CY : BOOL; (* флаг переноса *)
	Uncond : BOOL; (* безусловная форма команды *)
	PC : WORD; (* текущий счётчик команд *)
	Target : WORD; (* адрес перехода *)
	Len : BYTE; (* длина текущей команды *)
END_VAR
VAR_OUTPUT
	CondMet : BOOL; (* условие выполнено *)
	Take : BOOL; (* переход/вызов состоялся *)
	PC_Next : WORD; (* адрес следующей команды *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
