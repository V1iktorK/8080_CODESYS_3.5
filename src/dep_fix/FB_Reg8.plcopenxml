        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_Reg8
(* 8-разрядный регистр. Хранит байт между сканами PLC.
	Входы:  D - данные, LD - защёлкнуть, CLR - сброс (приоритетнее LD)
	Выходы: Q - текущее значение
	Поведение: Q := CLR ? 0 : (LD ? D : Q). Чтение Q в этой же схеме
	даёт значение ПРЕДЫДУЩЕГО скана - это и есть память регистра. *)
VAR_INPUT
	D : BYTE; (* входные данные *)
	LDx : BOOL; (* защёлкнуть: Q := D *)
	CLR : BOOL; (* сброс: Q := 0 (приоритет выше LD) *)
END_VAR
VAR_OUTPUT
	Q : BYTE; (* текущее значение регистра *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
