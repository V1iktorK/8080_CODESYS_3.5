          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_ALU8
(* 8-разрядное арифметико-логическое устройство.
	Входы:  OP - код операции, A и B - операнды, Cin - входной перенос
	Выходы: R - результат, CY - перенос/заём, AC - перенос из разряда 3,
	        S - знак, Z - ноль, P - чётность
	Коды OP: 0=ADD 1=ADC 2=SUB 3=SBB 4=ANA 5=ORA 6=XRA
	(CMP выполняется кодом 2, результат просто не записывается.)
	Ядро - 8 экземпляров FB_FullAdder, соединённых цепью переносов
	c0..c8. Переносы вынесены в отдельные переменные: во-первых так
	схема читается как настоящий сумматор, во-вторых выход вызова FB
	нельзя разветвлять (CODESYS выбрасывает такой POU).
	Вычитание: A + NOT(B) + 1 (дополнительный код).
	Логические операции: CY := 0, AC := 0 (у ANA AC := 1). *)
VAR_INPUT
	OP : BYTE; (* код операции 0..6 *)
	A : BYTE; (* операнд A (обычно аккумулятор) *)
	B : BYTE; (* операнд B *)
	Cin : BOOL; (* входной перенос для ADC/SBB *)
END_VAR
VAR_OUTPUT
	Rx : BYTE; (* результат *)
	CY : BOOL; (* перенос из старшего разряда *)
	AC : BOOL; (* перенос из разряда 3 *)
	Sx : BOOL; (* знак: R.7 *)
	Z : BOOL; (* ноль: R = 0 *)
	P : BOOL; (* чётность: чётное число единиц в R *)
END_VAR
VAR
	a0 : BOOL; (* разряд 0 операнда A *)
	b0 : BOOL; (* разряд 0 операнда B' *)
	s0 : BOOL; (* сумма разряда 0 *)
	a1 : BOOL; (* разряд 1 операнда A *)
	b1 : BOOL; (* разряд 1 операнда B' *)
	s1 : BOOL; (* сумма разряда 1 *)
	a2 : BOOL; (* разряд 2 операнда A *)
	b2 : BOOL; (* разряд 2 операнда B' *)
	s2 : BOOL; (* сумма разряда 2 *)
	a3 : BOOL; (* разряд 3 операнда A *)
	b3 : BOOL; (* разряд 3 операнда B' *)
	s3 : BOOL; (* сумма разряда 3 *)
	a4 : BOOL; (* разряд 4 операнда A *)
	b4 : BOOL; (* разряд 4 операнда B' *)
	s4 : BOOL; (* сумма разряда 4 *)
	a5 : BOOL; (* разряд 5 операнда A *)
	b5 : BOOL; (* разряд 5 операнда B' *)
	s5 : BOOL; (* сумма разряда 5 *)
	a6 : BOOL; (* разряд 6 операнда A *)
	b6 : BOOL; (* разряд 6 операнда B' *)
	s6 : BOOL; (* сумма разряда 6 *)
	a7 : BOOL; (* разряд 7 операнда A *)
	b7 : BOOL; (* разряд 7 операнда B' *)
	s7 : BOOL; (* сумма разряда 7 *)
	c0 : BOOL; (* перенос в разряд 0 *)
	c1 : BOOL; (* перенос в разряд 1 *)
	c2 : BOOL; (* перенос в разряд 2 *)
	c3 : BOOL; (* перенос в разряд 3 *)
	c4 : BOOL; (* перенос в разряд 4 *)
	c5 : BOOL; (* перенос в разряд 5 *)
	c6 : BOOL; (* перенос в разряд 6 *)
	c7 : BOOL; (* перенос в разряд 7 *)
	c8 : BOOL; (* перенос в разряд 8 *)
	fa0 : FB_FullAdder; (* сумматор разряда 0 *)
	fa1 : FB_FullAdder; (* сумматор разряда 1 *)
	fa2 : FB_FullAdder; (* сумматор разряда 2 *)
	fa3 : FB_FullAdder; (* сумматор разряда 3 *)
	fa4 : FB_FullAdder; (* сумматор разряда 4 *)
	fa5 : FB_FullAdder; (* сумматор разряда 5 *)
	fa6 : FB_FullAdder; (* сумматор разряда 6 *)
	fa7 : FB_FullAdder; (* сумматор разряда 7 *)
	ua : FB_UnpackByte; (* распаковка A *)
	ub : FB_UnpackByte; (* распаковка B после инверсии *)
	up : FB_PackByte; (* упаковка суммы *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations />
  </instances>
</project>
