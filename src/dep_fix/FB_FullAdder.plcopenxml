        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_FullAdder
(* Одноразрядный полный сумматор - основа АЛУ.
	Входы:  A, B - складываемые разряды, Cin - перенос из младшего разряда
	Выходы: Sum - сумма, Cout - перенос в старший разряд
	Логика: Sum  := A XOR B XOR Cin
	        Cout := (A AND B) OR (Cin AND (A XOR B))
	8 таких блоков, соединённых по переносу, дают 8-разрядный сумматор. *)
VAR_INPUT
	A : BOOL; (* разряд A *)
	B : BOOL; (* разряд B *)
	Cin : BOOL; (* перенос из младшего разряда *)
END_VAR
VAR_OUTPUT
	Sum : BOOL; (* сумма разряда *)
	Cout : BOOL; (* перенос в старший разряд *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
