        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_DecodeFull_STACK
(* Распознавание команд стека (группа C0h).
	Маска - CFh (биты 5..4 = код пары, бит 3 всегда 0):
	  (IR AND CFh)=C5h : PUSH rp - C5h BC, D5h DE, E5h HL, F5h PSW;
	  (IR AND CFh)=C1h : POP  rp - C1h BC, D1h DE, E1h HL, F1h PSW.
	Именно CFh, а не C7h: с маской C7h код E9h (PCHL) даёт C1h и
	ложно распознаётся как POP H.
	Класс операции: 29=PUSH, 30=POP.
	Пара берётся из битов 5..4 (C_RP): 0=BC 1=DE 2=HL 3=PSW
	(для PUSH/POP код 3 означает не SP, а байт состояния PSW -
	поэтому признак C_IsPSW формируется по C_RP = 3).
	PUSH: SP := SP-2, Memory[SP-1] := старший байт, Memory[SP-2] := младший.
	POP : младший байт := Memory[SP], старший := Memory[SP+1], SP := SP+2. *)
VAR_INPUT
	IR : BYTE; (* регистр команды *)
END_VAR
VAR_OUTPUT
	Hit : BOOL; (* это PUSH или POP *)
	Cls : BYTE; (* 29=PUSH 30=POP *)
END_VAR
VAR
	isp : BOOL; (* признак PUSH (IR AND CFh = C5h) *)
	ispo : BOOL; (* признак POP (IR AND CFh = C1h) *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
