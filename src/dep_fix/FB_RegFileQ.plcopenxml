        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_RegFileQ
(* Регистровый файл процессора 8080 с четырьмя портами записи.
	Коды регистров: 0=B 1=C 2=D 3=E 4=H 5=L 6=M 7=A
	(код 6 - не регистр, а память по адресу HL: её пишет FB_CPU8080).
	Входы: Data1..Data4 - четыре шины данных,
	        Dst1, Dst2  - коды регистров-приёмников для портов 1 и 2,
	        Wr1..Wr4    - разрешения записи по портам.
	Порты 3 и 4 адресуются жёстко: порт 3 - регистр H (код 4),
	порт 4 - регистр L (код 5). Так сделано потому, что их использует
	единственная команда - XCHG (H&lt;-D, L&lt;-E), а экономия на
	дешифраторе адреса уменьшает схему.
	Выходы: A, B, C, D, E, H, L - значения регистров (предыдущий такт). *)
VAR_INPUT
	Data1 : BYTE; (* шина данных порта 1 *)
	Dst1 : BYTE; (* код регистра-приёмника порта 1 *)
	Wr1 : BOOL; (* запись порта 1 *)
	Data2 : BYTE; (* шина данных порта 2 *)
	Dst2 : BYTE; (* код регистра-приёмника порта 2 *)
	Wr2 : BOOL; (* запись порта 2 *)
	Data3 : BYTE; (* шина данных порта 3 (только H) *)
	Wr3 : BOOL; (* запись порта 3 (H &lt;- Data3) *)
	Data4 : BYTE; (* шина данных порта 4 (только L) *)
	Wr4 : BOOL; (* запись порта 4 (L &lt;- Data4) *)
END_VAR
VAR_OUTPUT
	B : BYTE; (* регистр B *)
	C : BYTE; (* регистр C *)
	D : BYTE; (* регистр D *)
	E : BYTE; (* регистр E *)
	H : BYTE; (* регистр H *)
	L : BYTE; (* регистр L *)
	A : BYTE; (* регистр A *)
END_VAR
VAR
	rB : FB_Reg8Q; (* регистр B *)
	rC : FB_Reg8Q; (* регистр C *)
	rD : FB_Reg8Q; (* регистр D *)
	rE : FB_Reg8Q; (* регистр E *)
	rH : FB_Reg8Q; (* регистр H *)
	rL : FB_Reg8Q; (* регистр L *)
	rA : FB_Reg8Q; (* регистр A *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
