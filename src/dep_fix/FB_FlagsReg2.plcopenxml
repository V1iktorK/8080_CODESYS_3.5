        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_FlagsReg2
(* Регистр флагов с раздельной записью по каждому флагу.
	В 8080 флаги обновляются по-разному:
	  ADD/ADC/SUB/SBB/ANA/ORA/XRA/CMP и ADI..CPI - S, Z, AC, P, CY;
	  INR/DCR                                        - S, Z, AC, P (БЕЗ CY);
	  DAD, RLC/RRC/RAL/RAR, STC/CMC                  - ТОЛЬКО CY;
	  CMA                                            - ни один флаг;
	  DAA                                            - S, Z, AC, P, CY.
	Поэтому у каждого флага свой вход разрешения LD_S..LD_CY.
	LD_PSW (POP PSW) имеет приоритет над LD_*: флаги берутся из битов
	входного байта PSW_In, где 7=S 6=Z 4=AC 2=P 0=CY.
	Выход PSW - упакованный байт состояния (бит 1 всегда 1). *)
VAR_INPUT
	S_In : BOOL; (* новый флаг знака *)
	Z_In : BOOL; (* новый флаг нуля *)
	AC_In : BOOL; (* новый флаг дополнительного переноса *)
	P_In : BOOL; (* новый флаг чётности *)
	CY_In : BOOL; (* новый флаг переноса *)
	LD_S : BOOL; (* записать S *)
	LD_Z : BOOL; (* записать Z *)
	LD_AC : BOOL; (* записать AC *)
	LD_P : BOOL; (* записать P *)
	LD_CY : BOOL; (* записать CY *)
	PSW_In : BYTE; (* байт состояния для POP PSW *)
	LD_PSW : BOOL; (* загрузить все флаги из PSW_In *)
END_VAR
VAR_OUTPUT
	Sx : BOOL; (* знак *)
	Z : BOOL; (* ноль *)
	AC : BOOL; (* дополнительный перенос *)
	P : BOOL; (* чётность *)
	CY : BOOL; (* перенос *)
	PSW : BYTE; (* упакованный байт состояния *)
END_VAR
VAR
	upsw : FB_UnpackByte; (* распаковка PSW_In *)
	ppsw : FB_PackByte; (* упаковка PSW *)
	pb0 : BOOL; (* защёлкнутый бит 0 байта PSW_In *)
	pb1 : BOOL; (* защёлкнутый бит 1 байта PSW_In *)
	pb2 : BOOL; (* защёлкнутый бит 2 байта PSW_In *)
	pb3 : BOOL; (* защёлкнутый бит 3 байта PSW_In *)
	pb4 : BOOL; (* защёлкнутый бит 4 байта PSW_In *)
	pb5 : BOOL; (* защёлкнутый бит 5 байта PSW_In *)
	pb6 : BOOL; (* защёлкнутый бит 6 байта PSW_In *)
	pb7 : BOOL; (* защёлкнутый бит 7 байта PSW_In *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
