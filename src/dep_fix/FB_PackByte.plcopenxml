        <addData>
          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_PackByte
(* Упаковка 8 бит в байт (8 x BOOL -&gt; BYTE).
	Метод: каждый бит превращается в BYTE через SEL(0, вес),
	затем 8 значений складываются по ИЛИ деревом 8-&gt;4-&gt;2-&gt;1.
	Применяется для сборки PSW из флагов S,Z,AC,P,CY. *)
VAR_INPUT
	B0 : BOOL; (* разряд 0 (вес 1) *)
	B1 : BOOL; (* разряд 1 (вес 2) *)
	B2 : BOOL; (* разряд 2 (вес 4) *)
	B3 : BOOL; (* разряд 3 (вес 8) *)
	B4 : BOOL; (* разряд 4 (вес 16) *)
	B5 : BOOL; (* разряд 5 (вес 32) *)
	B6 : BOOL; (* разряд 6 (вес 64) *)
	B7 : BOOL; (* разряд 7 (вес 128) *)
END_VAR
VAR_OUTPUT
	B : BYTE; (* собранный байт *)
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
      </pou>
    </pous>
  </types>
