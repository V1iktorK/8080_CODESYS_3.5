# ============================================================================
#  .gitignore — проект «Intel 8080 + CP/M 2.2 на FBD в CODESYS 3.5»
#
#  Принцип: в репозитории лежит то, что НЕЛЬЗЯ пересоздать (генераторы,
#  документация, снимок зависимостей ядра, готовый .project), и не лежит то,
#  что генератор пересобирает за один прогон (схемы PLCopenXML, артефакты
#  компиляции, журналы).
# ============================================================================

# --- Готовый проект CODESYS: оставляем ТОЛЬКО его ---------------------------
# Всё остальное в build/ — загрузочные образы, кэши прекомпиляции,
# пользовательские .opt-файлы и *.bootinfo/*.compileinfo (по 4,8 МБ каждый).
build/*
!build/EMU8080_STAGE4.project

# --- Сгенерированные схемы (пересоздаются gen_stage4.py) --------------------
# src/s4_pous/ — 68 POU прикладного слоя, ~44 МБ.
# src/stage4_full*.xml — выгрузки всего проекта для анализа дефектов, ~96 МБ.
# src/dep_fix/ — НЕ игнорируется: это вход повторной сборки (27 POU ядра).
src/s4_pous/
src/stage4_full.plcopenxml
src/stage4_full_reexport.xml

# --- Промежуточные артефакты генератора -------------------------------------
generator/_renametest/
generator/_renametest_dep/
generator/_dryrun_stage4.plcopenxml
generator/**/_dryrun_*.plcopenxml
generator/**/*.stdout.txt
generator/**/*.stdout.txt.err

# --- Журналы прогонов и отчёты, пересобираемые автоматически ----------------
log/
report/stage4_report.md
report/*_run.md

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# --- Файлы, специфичные для машины/пользователя -----------------------------
# Имена .opt содержат имя учётной записи и имя компьютера.
*.opt
*.bak
*.backup
*.tmp
*~

# --- ОС и редакторы ---------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# --- Рабочая сцена CODESYS: никогда не коммитится ---------------------------
# Раннеры работают в изолированной сцене C:\dsh8080\work\*; если она окажется
# внутри дерева (клон на диск C:), её содержимое не должно попасть в git.
work/
emu/
emu_s3/
emu_s4/
dep_ccp/
